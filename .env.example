# API (apps/api/.env for local dev; Render environment in production). Names only, no values.
NODE_ENV=
PORT=
LOG_LEVEL=
APP_ORIGIN=
APP_URL=
COOKIE_DOMAIN=
MONGODB_URI=
JWT_SECRET=
JWT_SECRET_PREVIOUS=
DATA_ENCRYPTION_KEY=
INTERNAL_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Local development only (MinIO); rejected in production.
R2_ENDPOINT=
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=
FONT_DIR=
# memory (one instance) or mongo (shared across instances)
RATE_LIMIT_STORE=
# SMS reminders: console (default) or semaphore
SMS_PROVIDER=
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Optional error monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Web (apps/web/.env; Vercel environment in production)
VITE_API_URL=
VITE_SENTRY_DSN=
