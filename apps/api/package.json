{
  "name": "@licitatio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "create-staff": "tsx --env-file-if-exists=.env ../../scripts/create-staff.ts",
    "seed-requirements": "tsx --env-file-if-exists=.env ../../scripts/seed-requirements.ts",
    "seed-demo": "tsx --env-file-if-exists=.env ../../scripts/seed-demo.ts",
    "set-plan": "tsx --env-file-if-exists=.env ../../scripts/set-plan.ts",
    "reset-totp": "tsx --env-file-if-exists=.env ../../scripts/reset-totp.ts",
    "db:indexes": "tsx --env-file-if-exists=.env ../../scripts/db-indexes.ts",
    "purge-org": "tsx --env-file-if-exists=.env ../../scripts/purge-org.ts",
    "export-org": "tsx --env-file-if-exists=.env ../../scripts/export-org.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.716.0",
    "@aws-sdk/s3-request-presigner": "^3.716.0",
    "@licitatio/shared": "0.1.0",
    "@sentry/node": "^8.47.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.1.0",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "image-size": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "otplib": "^12.0.1",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.15",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pdfmake": "^0.2.11",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.2",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
