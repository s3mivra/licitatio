{
  "name": "licitatio",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @licitatio/api && npm run build -w @licitatio/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev -w @licitatio/api",
    "dev:web": "npm run dev -w @licitatio/web",
    "create-staff": "npm run create-staff -w @licitatio/api --",
    "seed-requirements": "npm run seed-requirements -w @licitatio/api",
    "seed-demo": "npm run seed-demo -w @licitatio/api",
    "set-plan": "npm run set-plan -w @licitatio/api --",
    "reset-totp": "npm run reset-totp -w @licitatio/api --",
    "db:indexes": "npm run db:indexes -w @licitatio/api",
    "purge-org": "npm run purge-org -w @licitatio/api --",
    "export-org": "npm run export-org -w @licitatio/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
